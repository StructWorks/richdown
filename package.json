{
  "name": "richdown",
  "displayName": "Richdown",
  "description": "Edit Markdown with a rich inline preview, editable tables, colored Mermaid diagrams, Gherkin boards, HTML/PDF export, Richdown diffs, and a focused writing flow in VS Code.",
  "version": "0.9.1",
  "publisher": "mytooyodev",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StructWorks/richdown.git"
  },
  "bugs": {
    "url": "https://github.com/StructWorks/richdown/issues"
  },
  "homepage": "https://github.com/StructWorks/richdown#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "rich editor",
    "live preview",
    "diff",
    "mermaid",
    "gherkin",
    "bdd",
    "tables",
    "notes"
  ],
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "extensionKind": [
    "ui"
  ],
  "icon": "resources/icon.png",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:richdown.toggle",
    "onCommand:richdown.openRichDiff",
    "onCommand:richdown.exportHtml",
    "onCommand:richdown.exportPdf",
    "onCustomEditor:richdown.richEditor"
  ],
  "main": "./extension.js",
  "scripts": {
    "vscode:prepublish": "npm run build:all",
    "build": "esbuild src/richEditor.js --bundle --format=iife --outfile=media/richEditor.js",
    "build:mermaid": "esbuild src/mermaidLoader.js --bundle --format=iife --outfile=media/mermaid.js",
    "build:diff": "esbuild src/richDiff.js --bundle --format=iife --outfile=media/richDiff.js",
    "build:all": "npm run build && npm run build:mermaid && npm run build:diff",
    "generate:schema": "node scripts/generate-config-schema.mjs",
    "package:vsix": "vsce package",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify:bundles": "node scripts/verify-bundles.mjs",
    "publish:marketplace": "vsce publish",
    "publish:openvsx": "ovsx publish",
    "watch": "esbuild src/richEditor.js --bundle --format=iife --outfile=media/richEditor.js --watch"
  },
  "contributes": {
    "commands": [
      {
        "command": "richdown.toggle",
        "title": "Richdown: Toggle Markdown Open Mode",
        "shortTitle": "Toggle Richdown",
        "icon": {
          "light": "resources/icons/editor-toggle-light.svg",
          "dark": "resources/icons/editor-toggle-dark.svg"
        }
      },
      {
        "command": "richdown.openGitDiff",
        "title": "Richdown: Open Git Diff",
        "shortTitle": "Open Git Diff",
        "icon": "$(compare-changes)"
      },
      {
        "command": "richdown.openRichDiff",
        "title": "Richdown: Open Rich Diff",
        "shortTitle": "Open Rich Diff",
        "icon": "$(diff)"
      },
      {
        "command": "richdown.exportHtml",
        "title": "Richdown: Export HTML",
        "shortTitle": "Export HTML",
        "icon": "$(file-code)"
      },
      {
        "command": "richdown.exportPdf",
        "title": "Richdown: Export PDF",
        "shortTitle": "Export PDF",
        "icon": "$(file-pdf)"
      },
      {
        "command": "richdown.formatDocument",
        "title": "Richdown: Format Document",
        "shortTitle": "Format Document"
      },
      {
        "command": "richdown.createConfig",
        "title": "Richdown: Create Formatter and Lint Configuration",
        "shortTitle": "Create .richdownrc.json"
      }
    ],
    "languages": [
      {
        "id": "jsonc",
        "filenames": [
          ".richdownrc.json"
        ]
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".richdownrc.json",
        "url": "./schemas/richdownrc.schema.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "richdown.richEditor",
        "displayName": "Richdown Markdown Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "Richdown",
      "properties": {
        "richdown.openMarkdownAsRichEditor": {
          "type": "boolean",
          "default": true,
          "description": "Open regular Markdown files with Richdown by default, including files opened over a remote connection such as WSL, SSH, Dev Containers, or Codespaces. Source Control diffs continue to use VS Code's native diff editor."
        },
        "richdown.jumpToOpenedPosition": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Also jump to the requested position for VS Code Search results and links in Copilot Chat, and highlight the match. Links that extensions such as Claude Code and Codex open already jump without this. VS Code passes the position only to text editors, so with this on, every Markdown file opens in the text editor first and switches to Richdown right away, which causes a visible flicker. Requires `#richdown.openMarkdownAsRichEditor#`."
        },
        "richdown.richTheme": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "midnight",
            "graphite",
            "forest",
            "ivory",
            "paper",
            "solar"
          ],
          "enumDescriptions": [
            "Follow the active VS Code theme.",
            "Dark blue-black theme.",
            "Neutral dark gray theme.",
            "Dark green writing theme.",
            "Warm light theme.",
            "Clean white paper theme.",
            "Soft warm light theme."
          ],
          "description": "Theme used inside the Rich Editor."
        },
        "richdown.richTablePreview": {
          "type": "boolean",
          "default": true,
          "description": "Show Markdown tables as rich editable tables in the Rich Editor."
        },
        "richdown.gherkinPreview": {
          "type": "boolean",
          "default": true,
          "description": "Render Gherkin code blocks as BDD boards in the Rich Editor."
        },
        "richdown.mermaidPreview": {
          "type": "boolean",
          "default": true,
          "description": "Render Mermaid code blocks as diagrams in the Rich Editor."
        },
        "richdown.mermaidColorized": {
          "type": "boolean",
          "default": true,
          "description": "Apply Richdown's clearer color palette to Mermaid diagrams."
        },
        "richdown.mermaidPreviewSize": {
          "type": "string",
          "default": "readable",
          "enum": [
            "source",
            "readable",
            "large"
          ],
          "enumDescriptions": [
            "Match the source block height.",
            "Use a readable minimum height.",
            "Use a larger fitted preview height for detailed diagrams."
          ],
          "description": "Controls the preview height used for Mermaid diagrams in the Rich Editor."
        },
        "richdown.previewWidth": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "wide"
          ],
          "enumDescriptions": [
            "Use the default writing width.",
            "Use the full editor width."
          ],
          "description": "Controls the content width used inside the Rich Editor."
        },
        "richdown.lint.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Check Markdown files and show problems in the Problems panel and the Rich Editor. Turn individual rules on or off in a `.richdownrc.json` file; run **Richdown: Create Formatter and Lint Configuration** to create one with every rule listed."
        },
        "richdown.formatOnSave": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "Format Markdown files with Richdown's formatter when they are saved. Formatter rules are turned on or off in `.richdownrc.json`. Auto save after a delay does not format."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "richdown.openRichDiff",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@1"
        },
        {
          "command": "richdown.openGitDiff",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@2"
        },
        {
          "command": "richdown.toggle",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@3"
        },
        {
          "command": "richdown.exportHtml",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@4"
        },
        {
          "command": "richdown.exportPdf",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@5"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "richdown.openRichDiff",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "richdown.openRichDiff"
        },
        {
          "command": "richdown.openGitDiff"
        },
        {
          "command": "richdown.exportHtml"
        },
        {
          "command": "richdown.exportPdf"
        },
        {
          "command": "richdown.toggle"
        },
        {
          "command": "richdown.formatDocument"
        },
        {
          "command": "richdown.createConfig"
        }
      ]
    }
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "ovsx": "^0.10.12",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "mermaid": "^11.15.0"
  }
}
