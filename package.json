{
  "name": "richdown",
  "displayName": "Richdown",
  "description": "Edit Markdown with a rich inline preview, editable tables, Mermaid diagrams, and a focused writing flow in VS Code.",
  "version": "0.1.0",
  "publisher": "mytooyodev",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StructWorks/richdown.git"
  },
  "bugs": {
    "url": "https://github.com/StructWorks/richdown/issues"
  },
  "homepage": "https://github.com/StructWorks/richdown#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "rich editor",
    "live preview",
    "mermaid",
    "tables",
    "notes"
  ],
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "extensionKind": [
    "ui"
  ],
  "icon": "resources/icon.png",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:richdown.toggle",
    "onCustomEditor:richdown.richEditor"
  ],
  "main": "./extension.js",
  "scripts": {
    "vscode:prepublish": "npm run build:all",
    "build": "esbuild src/richEditor.js --bundle --format=iife --outfile=media/richEditor.js",
    "build:mermaid": "esbuild src/mermaidLoader.js --bundle --format=iife --outfile=media/mermaid.js",
    "build:all": "npm run build && npm run build:mermaid",
    "package:vsix": "vsce package",
    "publish:marketplace": "vsce publish",
    "publish:openvsx": "ovsx publish",
    "watch": "esbuild src/richEditor.js --bundle --format=iife --outfile=media/richEditor.js --watch"
  },
  "contributes": {
    "commands": [
      {
        "command": "richdown.toggle",
        "title": "Richdown: Toggle Markdown Open Mode",
        "shortTitle": "Toggle Richdown",
        "icon": {
          "light": "resources/icons/editor-toggle-light.svg",
          "dark": "resources/icons/editor-toggle-dark.svg"
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "richdown.richEditor",
        "displayName": "Richdown Markdown Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "Richdown",
      "properties": {
        "richdown.openMarkdownAsRichEditor": {
          "type": "boolean",
          "default": true,
          "description": "Open Markdown files with Richdown by default. Disable to use the standard VS Code text editor."
        },
        "richdown.richTheme": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "midnight",
            "graphite",
            "forest",
            "ivory",
            "paper",
            "solar"
          ],
          "enumDescriptions": [
            "Follow the active VS Code theme.",
            "Dark blue-black theme.",
            "Neutral dark gray theme.",
            "Dark green writing theme.",
            "Warm light theme.",
            "Clean white paper theme.",
            "Soft warm light theme."
          ],
          "description": "Theme used inside the Rich Editor."
        },
        "richdown.showEmptyLineHint": {
          "type": "boolean",
          "default": true,
          "description": "Show the Click to write hint for empty lines in the Rich Editor."
        },
        "richdown.richTablePreview": {
          "type": "boolean",
          "default": true,
          "description": "Show Markdown tables as rich editable tables in the Rich Editor."
        },
        "richdown.mermaidPreview": {
          "type": "boolean",
          "default": true,
          "description": "Render Mermaid code blocks as diagrams in the Rich Editor."
        },
        "richdown.mermaidPreviewSize": {
          "type": "string",
          "default": "readable",
          "enum": [
            "source",
            "readable",
            "large"
          ],
          "enumDescriptions": [
            "Match the source block height.",
            "Use a readable minimum height.",
            "Use a larger fitted preview height for detailed diagrams."
          ],
          "description": "Controls the preview height used for Mermaid diagrams in the Rich Editor."
        },
        "richdown.previewWidth": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "wide"
          ],
          "enumDescriptions": [
            "Use the default writing width.",
            "Use the full editor width."
          ],
          "description": "Controls the content width used inside the Rich Editor."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "richdown.toggle",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "richdown.toggle"
        }
      ]
    }
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.3",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "ovsx": "^0.10.12"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "mermaid": "^11.15.0"
  }
}
